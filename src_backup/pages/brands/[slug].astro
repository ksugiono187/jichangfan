---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map(brand => ({
    params: { slug: brand.id },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const { Content } = await render(brand);
---
<BaseLayout title={`${brand.data.name} 详情`} description={brand.data.description}>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <div class="bg-white border rounded-2xl p-8 mb-8">
      <h1 class="text-3xl font-bold mb-2">{brand.data.name}</h1>
      <span class="text-sm bg-gray-100 px-3 py-1 rounded-full">{brand.data.category}</span>
      <p class="mt-4 text-gray-600">{brand.data.description}</p>
      <div class="mt-6">
        <a href={`/go/${brand.id}`} target="_blank" rel="nofollow noopener" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-blue-700">访问官网</a>
      </div>
    </div>
    <div class="prose max-w-none bg-white p-8 rounded-2xl border">
      <Content />
    </div>
  </div>
</BaseLayout>
