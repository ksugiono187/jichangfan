---
interface Props {
  title: string;
  subtitle: string;
  primaryCta: { text: string; href: string };
  secondaryCta: { text: string; href: string };
}
const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---
<section class="py-20 md:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-blue-50/50 to-transparent -z-10"></div>
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-6 tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-gray-600 mb-8 leading-relaxed max-w-lg">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={primaryCta.href} class="bg-blue-600 text-white px-8 py-3.5 rounded-full font-semibold hover:bg-blue-700 transition-all shadow-md hover:shadow-lg">
          {primaryCta.text}
        </a>
        <a href={secondaryCta.href} class="bg-white text-gray-800 border border-gray-200 px-8 py-3.5 rounded-full font-semibold hover:bg-gray-50 transition-all shadow-sm">
          {secondaryCta.text}
        </a>
      </div>
    </div>
    <div class="relative hidden md:block">
      <div class="absolute inset-0 bg-gradient-to-tr from-blue-100 to-purple-50 rounded-3xl transform rotate-3 scale-105 -z-10"></div>
      <div class="bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
        <div class="flex items-center justify-between mb-6">
          <div class="h-3 w-1/3 bg-gray-200 rounded-full"></div>
          <div class="h-8 w-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          </div>
        </div>
        <div class="space-y-4">
          <div class="h-4 w-full bg-gray-100 rounded-md"></div>
          <div class="h-4 w-5/6 bg-gray-100 rounded-md"></div>
          <div class="h-4 w-4/6 bg-gray-100 rounded-md"></div>
        </div>
        <div class="mt-8 pt-6 border-t border-gray-50 flex justify-between items-center text-sm text-gray-500">
          <span>信任·专业·客观</span>
          <span class="px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-medium">Verified</span>
        </div>
      </div>
    </div>
  </div>
</section>
