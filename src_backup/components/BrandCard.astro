---
interface Props {
  brand: any;
}
const { brand } = Astro.props;
---
<div class="bg-white border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xl font-bold text-gray-900">{brand.data.name}</h3>
    <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{brand.data.category}</span>
  </div>
  <p class="text-gray-600 text-sm mb-6 line-clamp-2">{brand.data.description}</p>
  <a href={`/brands/${brand.id}`} class="block text-center w-full py-2 bg-blue-50 text-blue-600 rounded-lg text-sm font-medium hover:bg-blue-600 hover:text-white transition-colors">查看详情</a>
</div>
