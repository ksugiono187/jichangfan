<div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
  <table class="w-full text-left border-collapse bg-white">
    <thead>
      <tr class="bg-gray-50 border-b border-gray-200">
        <th class="p-4 font-semibold text-gray-900">服务名称</th>
        <th class="p-4 font-semibold text-gray-900">月付价格</th>
        <th class="p-4 font-semibold text-gray-900">流媒体解锁</th>
        <th class="p-4 font-semibold text-gray-900">节点数量</th>
        <th class="p-4 font-semibold text-gray-900 text-center">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="p-4 font-medium text-gray-900">示例服务 A</td>
        <td class="p-4 text-gray-600">￥25.00</td>
        <td class="p-4 text-gray-600">✅ 全解锁</td>
        <td class="p-4 text-gray-600">50+</td>
        <td class="p-4 text-center"><a href="#" class="text-blue-600 font-medium hover:underline">查看</a></td>
      </tr>
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="p-4 font-medium text-gray-900">示例服务 B</td>
        <td class="p-4 text-gray-600">￥15.00</td>
        <td class="p-4 text-gray-600">⚠️ 部分解锁</td>
        <td class="p-4 text-gray-600">30+</td>
        <td class="p-4 text-center"><a href="#" class="text-blue-600 font-medium hover:underline">查看</a></td>
      </tr>
    </tbody>
  </table>
</div>
