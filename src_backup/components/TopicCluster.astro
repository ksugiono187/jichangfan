---
interface Props {
  topics: any[];
}
const { topics } = Astro.props;
---
<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
  {topics.map(topic => (
    <div class="bg-gradient-to-br from-gray-50 to-white border border-gray-200 p-8 rounded-3xl hover:border-blue-200 transition-colors">
      <h3 class="text-2xl font-bold text-gray-900 mb-3">{topic.data.title}</h3>
      <p class="text-gray-600 mb-6 text-sm">{topic.data.description}</p>
      <a href={`/topics/${topic.id}`} class="inline-flex items-center font-semibold text-blue-600 hover:text-blue-700">进入专题 <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
    </div>
  ))}
</div>
