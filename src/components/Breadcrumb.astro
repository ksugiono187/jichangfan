---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-sm text-zinc-400">
    <li><a href="/" class="hover:text-zinc-50 transition-colors">首页</a></li>
    {items.map(item => (
      <li class="flex items-center gap-2">
        <span class="text-gray-400">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-zinc-50 transition-colors">{item.label}</a>
        ) : (
          <span class="text-zinc-50 font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
