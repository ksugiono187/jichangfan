---
interface Props {
  title: string;
  desc: string;
  icon: string;
  href: string;
}
const { title, desc, icon, href } = Astro.props;
---
<a href={href} class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800 shadow-sm hover:shadow-md hover:border-amber-900/40 transition-all block group">
  <div class="w-12 h-12 bg-amber-900/20 text-amber-500 rounded-xl flex items-center justify-center mb-5 group-hover:bg-amber-500 group-hover:text-white transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon} />
    </svg>
  </div>
  <h3 class="text-xl font-bold text-zinc-50 mb-2">{title}</h3>
  <p class="text-zinc-400 text-sm">{desc}</p>
</a>
