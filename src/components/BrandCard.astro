---
interface Props {
  brand: any;
}
const { brand } = Astro.props;
---
<div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xl font-bold text-zinc-50">{brand.data.name}</h3>
    <span class="text-xs bg-zinc-800 text-zinc-400 px-2 py-1 rounded">{brand.data.category}</span>
  </div>
  <p class="text-zinc-400 text-sm mb-6 line-clamp-2">{brand.data.description}</p>
  <a href={`/brands/${brand.id}`} class="block text-center w-full py-2 bg-amber-900/20 text-amber-500 rounded-lg text-sm font-medium hover:bg-amber-500 hover:text-white transition-colors">查看详情</a>
</div>
