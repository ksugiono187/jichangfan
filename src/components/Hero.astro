---
interface Props {
  title: string;
  subtitle: string;
  primaryCta: { text: string; href: string };
  secondaryCta: { text: string; href: string };
}
const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---
<section class="py-20 md:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-amber-900/10 to-transparent -z-10"></div>
  
  <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-zinc-50 leading-tight mb-6 tracking-tight">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-zinc-400 mb-8 leading-relaxed max-w-lg">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={primaryCta.href} class="bg-amber-500 text-zinc-950 px-8 py-3.5 rounded-full font-bold hover:bg-amber-400 transition-all shadow-[0_0_20px_rgba(245,158,11,0.3)]">
          {primaryCta.text}
        </a>
        <a href={secondaryCta.href} class="bg-zinc-900 text-zinc-100 border border-zinc-700 px-8 py-3.5 rounded-full font-semibold hover:bg-zinc-800 transition-all">
          {secondaryCta.text}
        </a>
      </div>
    </div>
    
    <div class="relative hidden md:block">
      <!-- Glow effect -->
      <div class="absolute -inset-1 bg-gradient-to-r from-amber-600 to-yellow-600 rounded-3xl blur opacity-20"></div>
      
      <!-- Main card -->
      <div class="relative bg-zinc-900/90 backdrop-blur-sm p-8 rounded-3xl border border-zinc-800 shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
        <!-- Top bar -->
        <div class="flex items-center justify-between mb-8">
          <div class="flex space-x-2">
            <div class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"></div>
          </div>
          <div class="px-3 py-1 bg-amber-500/10 border border-amber-500/20 rounded-full flex items-center shadow-[0_0_10px_rgba(245,158,11,0.1)]">
             <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse mr-2"></span>
             <span class="text-xs font-bold text-amber-500 tracking-wider uppercase">Secure Link</span>
          </div>
        </div>
        
        <!-- Content -->
        <div class="space-y-6 font-mono">
          <div class="flex justify-between items-end border-b border-zinc-800/80 pb-4">
            <div>
              <div class="text-zinc-500 text-xs mb-1">NODE</div>
              <div class="text-zinc-200">IEPL-HK-VIP <span class="text-amber-500 ml-1">★</span></div>
            </div>
            <div class="text-right">
              <div class="text-zinc-500 text-xs mb-1">LATENCY</div>
              <div class="text-green-400">24ms</div>
            </div>
          </div>
          
          <div class="flex justify-between items-end border-b border-zinc-800/80 pb-4">
            <div>
              <div class="text-zinc-500 text-xs mb-1">PROTOCOL</div>
              <div class="text-zinc-200">VLESS / XTLS</div>
            </div>
            <div class="text-right">
              <div class="text-zinc-500 text-xs mb-1">SPEED</div>
              <div class="text-amber-400">1.2 Gbps</div>
            </div>
          </div>
        </div>
        
        <!-- Bottom -->
        <div class="mt-8 pt-4 flex justify-between items-center text-sm text-zinc-500">
          <div class="flex items-center text-zinc-400">
            <svg class="w-4 h-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            100% 客观真实测速
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
