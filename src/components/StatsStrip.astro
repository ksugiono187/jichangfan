---
interface Props {
  stats: { label: string; value: string }[];
}
const { stats } = Astro.props;
---
<div class="bg-zinc-900 border-y border-zinc-800 py-8">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-gray-50">
      {stats.map(stat => (
        <div>
          <div class="text-3xl md:text-4xl font-bold text-amber-500 mb-2">{stat.value}</div>
          <div class="text-sm font-medium text-zinc-400 uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</div>
