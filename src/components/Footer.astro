---
import { FOOTER_LINKS } from '../data/nav';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-gray-900 text-gray-300 py-12 md:py-16 mt-20">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2 md:col-span-1">
      <div class="text-2xl font-bold text-white mb-4">{SITE.title}</div>
      <p class="text-gray-400 text-sm leading-relaxed mb-6">{SITE.description}</p>
    </div>
    
    {FOOTER_LINKS.map(section => (
      <div>
        <h3 class="text-white font-semibold mb-4">{section.title}</h3>
        <ul class="space-y-3">
          {section.links.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">{link.text}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="max-w-6xl mx-auto px-4 mt-12 pt-8 border-t border-gray-800 text-sm text-zinc-400 flex flex-col md:flex-row justify-between items-center">
    <p>&copy; {year} {SITE.title}. All rights reserved.</p>
    <p class="mt-2 md:mt-0">致力于提供客观、真实的评测内容</p>
  </div>
</footer>
