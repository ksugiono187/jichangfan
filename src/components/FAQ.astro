---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="max-w-3xl mx-auto space-y-4">
  {items.map((item, i) => (
    <details class="group bg-zinc-900 rounded-xl border border-zinc-800 [&_summary::-webkit-details-marker]:hidden" open={i === 0}>
      <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-zinc-50 font-medium">
        <h3 class="text-lg">{item.q}</h3>
        <span class="shrink-0 rounded-full bg-zinc-950 p-1.5 text-zinc-50 sm:p-3 group-open:bg-amber-900/20 group-open:text-amber-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 transition duration-300 group-open:-rotate-180" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </span>
      </summary>
      <div class="p-5 pt-0 text-zinc-400 leading-relaxed text-sm">
        {item.a}
      </div>
    </details>
  ))}
</div>
