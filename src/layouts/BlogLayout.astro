---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'> | null;
  prevPost?: CollectionEntry<'blog'> | null;
}
const { post, nextPost, prevPost } = Astro.props;
const keywords = post.data.tags ? post.data.tags.join(', ') : undefined;
---
<BaseLayout title={post.data.title} description={post.data.description} keywords={keywords}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[{label: '博客', href: '/blog/'}, {label: post.data.title}]} />
    
    <article class="mt-8 bg-zinc-900 p-6 md:p-10 rounded-2xl shadow-xl border border-zinc-800">
      <header class="mb-8 border-b border-zinc-800 pb-8">
        <h1 class="text-3xl md:text-4xl font-extrabold text-zinc-50 mb-4 leading-tight">{post.data.title}</h1>
        <div class="flex flex-wrap gap-4 text-sm text-zinc-400">
          <time datetime={post.data.pubDate.toISOString()}>发布于：{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          {post.data.updatedDate && (
            <time datetime={post.data.updatedDate.toISOString()}>更新于：{post.data.updatedDate.toLocaleDateString('zh-CN')}</time>
          )}
          <span>分类：<a href={`/category/${post.data.category}`} class="text-amber-500 hover:underline">{post.data.category}</a></span>
          <span>作者：{post.data.author}</span>
        </div>
      </header>
      
      <!-- Top Navigation -->
      {(prevPost || nextPost) && (
        <div class="flex justify-between items-center mb-10 pb-6 border-b border-zinc-800/50 gap-4">
          {prevPost && (
            <a href={`/blog/${prevPost.id}`} class="text-sm bg-zinc-800/80 text-zinc-200 hover:bg-amber-500 hover:text-zinc-950 hover:border-amber-500 px-5 py-2.5 rounded-full flex items-center transition-all font-medium border border-zinc-700/50 shadow-sm group">
              <svg class="w-4 h-4 mr-1.5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              <span class="hidden sm:inline">上一篇：</span><span class="sm:hidden">上一篇</span><span class="hidden sm:inline truncate max-w-[150px]">{prevPost.data.title}</span>
            </a>
          )}
          {!prevPost && <div></div>}
          
          {nextPost && (
            <a href={`/blog/${nextPost.id}`} class="text-sm bg-zinc-800/80 text-zinc-200 hover:bg-amber-500 hover:text-zinc-950 hover:border-amber-500 px-5 py-2.5 rounded-full flex items-center transition-all font-medium border border-zinc-700/50 shadow-sm group">
              <span class="hidden sm:inline">下一篇：</span><span class="sm:hidden">下一篇</span><span class="hidden sm:inline truncate max-w-[150px]">{nextPost.data.title}</span>
              <svg class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          )}
        </div>
      )}
      
      <div class="prose prose-lg max-w-none prose-invert prose-amber prose-img:rounded-xl prose-headings:text-zinc-100 prose-a:text-amber-500 hover:prose-a:text-amber-400">
        <slot />
      </div>
      
      <!-- Bottom Navigation -->
      {(prevPost || nextPost) && (
        <div class="flex justify-between items-center mt-12 pt-10 border-t border-zinc-800 gap-4">
          {prevPost && (
            <a href={`/blog/${prevPost.id}`} class="text-sm bg-zinc-800/80 text-zinc-200 hover:bg-amber-500 hover:text-zinc-950 hover:border-amber-500 px-5 py-2.5 rounded-full flex items-center transition-all font-medium border border-zinc-700/50 shadow-sm group">
              <svg class="w-4 h-4 mr-1.5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
              <span class="hidden sm:inline">上一篇：</span><span class="sm:hidden">上一篇</span><span class="hidden sm:inline truncate max-w-[150px]">{prevPost.data.title}</span>
            </a>
          )}
          {!prevPost && <div></div>}
          
          {nextPost && (
            <a href={`/blog/${nextPost.id}`} class="text-sm bg-zinc-800/80 text-zinc-200 hover:bg-amber-500 hover:text-zinc-950 hover:border-amber-500 px-5 py-2.5 rounded-full flex items-center transition-all font-medium border border-zinc-700/50 shadow-sm group">
              <span class="hidden sm:inline">下一篇：</span><span class="sm:hidden">下一篇</span><span class="hidden sm:inline truncate max-w-[150px]">{nextPost.data.title}</span>
              <svg class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          )}
        </div>
      )}
      
      <div class="mt-8 pt-6 border-t border-zinc-800 flex flex-wrap gap-2 items-center">
        <span class="text-zinc-400 mr-2 text-sm">标签：</span>
        {post.data.tags.map(tag => (
          <a href={`/tag/${tag}`} class="bg-zinc-800 border border-zinc-700 text-zinc-300 px-3 py-1 rounded-full text-xs hover:border-amber-500 hover:text-amber-500 transition-colors">{tag}</a>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>
