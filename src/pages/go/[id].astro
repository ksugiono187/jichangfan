---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { REDIRECTS } from '../../data/redirects';

export function getStaticPaths() {
  const ids = Object.keys(REDIRECTS);
  return ids.map(id => ({
    params: { id },
  }));
}

const { id } = Astro.params;
const targetUrl = REDIRECTS[id] || '/';
---
<BaseLayout title="正在跳转..." description="页面跳转中" noindex={true}>
  <div class="max-w-md mx-auto px-4 py-32 text-center">
    <div class="w-16 h-16 border-4 border-amber-700/50 border-t-amber-500 rounded-full animate-spin mx-auto mb-8"></div>
    <h1 class="text-2xl font-bold mb-4">正在前往目标页面</h1>
    <p class="text-zinc-400 mb-8">您即将离开本站，请注意保护您的个人信息安全。</p>
    <p class="text-sm text-gray-400">如果浏览器没有自动跳转，请 <a href={targetUrl} rel="nofollow noopener" class="text-amber-500 hover:underline">点击这里</a></p>
    
    <script is:inline define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.href = targetUrl;
      }, 1500);
    </script>
  </div>
</BaseLayout>
