---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="独家优惠券 | 机场翻" description="为您提供各大机场最新鲜的优惠码与折扣信息。">
  <main class="py-20 md:py-32 relative">
    <!-- Glow Effect -->
    <div class="absolute top-0 inset-x-0 h-96 bg-gradient-to-b from-amber-900/20 to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 relative z-10">
