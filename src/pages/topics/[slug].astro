---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(topic => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const allPosts = await getCollection('blog');

// 根据专题的 ID 或 Title 动态匹配相关的文章
const relatedPosts = allPosts.filter(post => {
  const keywordStr = `${topic.id} ${topic.data.title}`.toLowerCase();
  const searchStr = `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase();
  
  // 简单匹配：如果文章标题、描述、标签中包含专题的任意关键词（取交集或部分匹配）
  if (topic.id === 'beginner') return searchStr.includes('新手') || searchStr.includes('常见解答');
  if (topic.id === 'clash') return searchStr.includes('clash');
  if (topic.id === 'shadowrocket') return searchStr.includes('shadowrocket') || searchStr.includes('小火箭');
  if (topic.id === 'sing-box') return searchStr.includes('sing-box') || searchStr.includes('singbox');
  if (topic.id === 'airport-guide') return searchStr.includes('机场') || searchStr.includes('评测') || searchStr.includes('对比');
  
  // 默认回退匹配
  return searchStr.includes(topic.id.toLowerCase());
}).slice(0, 6);

// 如果匹配不到，则随机/默认显示最新的6篇
const finalPosts = relatedPosts.length > 0 ? relatedPosts : allPosts.slice(0, 6);
---
<BaseLayout title={topic.data.title} description={topic.data.description}>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <div class="bg-amber-900/20 rounded-3xl p-10 mb-12 text-center">
      <h1 class="text-4xl font-bold text-zinc-50 mb-4">{topic.data.title}</h1>
      <p class="text-lg text-zinc-400">{topic.data.description}</p>
    </div>
    <div class="prose prose-lg prose-invert prose-amber max-w-none bg-zinc-900 p-8 sm:p-12 rounded-3xl border border-zinc-800 shadow-xl mb-16 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-amber-500 prose-table:w-full prose-th:bg-zinc-800/50 prose-th:p-4 prose-th:text-left prose-td:p-4 prose-tr:border-b prose-tr:border-zinc-800">
      <Content />
    </div>
    <h2 class="text-2xl font-bold mb-6">专题相关文章</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {finalPosts.map(post => <ArticleCard post={post} />)}
    </div>
  </div>
</BaseLayout>
